AZURE_OPENAI_ENDPOINT=https://aif-qasandboxjii-001.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_KEY=replace-with-your-azure-ai-api-key

# A projektben még nincs felhasználói autentikáció. A rangsor ezért
# alapértelmezetten csak olvasható; helyi, védett környezetben az engedélyek
# szerveroldali listával kapcsolhatók be.
RANKING_PERMISSIONS=view,process,override,reorder,edit_weights,edit_criteria,reevaluate,reset
RANKING_ACTOR=local-operator

# Ha nincs API-kulcs beállítva, a hitelesítést a DefaultAzureCredential kezeli.
# Helyi fejlesztésnél például az `az login`, Azure-ban Managed Identity használható.
